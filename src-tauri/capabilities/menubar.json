{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "menubar",
  "description": "Read events for the quick dashboard; window and account actions use bounded Rust commands",
  "windows": [
    "menubar"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-background-color",
    "allow-get-menu-bar-appearance",
    "allow-open-app-page",
    "allow-hide-menu-bar-dashboard",
    "allow-quit-app",
    "allow-get-menu-bar-snapshot",
    "allow-switch-account",
    "allow-refresh-all-quotas",
    "allow-open-project-page",
    "allow-get-menu-bar-usage"
  ]
}
